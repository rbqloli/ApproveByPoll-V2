[botapi]
enable = false
api_server = "http://127.0.0.1:8081"

[database]
# driver: "postgres" (default) or "sqlite"
driver = "postgres"
host = "127.0.0.1"
port = 5432
user = "postgres"
password = "postgres"
dbname = "postgres"
# Only used when driver = "sqlite"
path = "data/approvebypoll.db"

[logchannel]
enable = false
channel_id = -1001234567890
message_thread_id = 0
